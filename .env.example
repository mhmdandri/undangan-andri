# ==============================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Undangan Digital Andri & Cica
# ==============================================================

# --------------------------------------------------------------
# 1. URL Frontend / Website Utama
# --------------------------------------------------------------
# Digunakan untuk:
# - metadataBase di Next.js (app/layout.tsx)
# - Pembuatan absolute URL untuk OpenGraph Image (thumbnail WhatsApp, Facebook, dll)
# - Canonical URL untuk SEO
#
# Production: https://andricica.mohaproject.tech
# Local Dev : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://andricica.mohaproject.tech

# --------------------------------------------------------------
# 2. URL API Publik (Client-side / Browser)
# --------------------------------------------------------------
# Digunakan untuk:
# - Endpoint backend yang diakses dari browser pengguna
# - Submit RSVP, kirim ucapan/komentar, dan pengecekan reservasi publik
#
# Production: https://api.mohaproject.tech
# Local Dev : http://localhost:8888
NEXT_PUBLIC_API_URL=https://api.mohaproject.tech

# --------------------------------------------------------------
# 3. URL API Internal (Server-side / Next.js API Routes & SSR)
# --------------------------------------------------------------
# Digunakan untuk:
# - Komunikasi langsung server-to-server Next.js ke backend Go (port 8888)
# - Digunakan pada:
#   * app/page.tsx (auto-lookup nama tamu via ?code=)
#   * app/api/reservations/check-in/[code]/route.ts (proxy check-in tamu)
#   * app/api/reservations/check-in/route.ts (submit kehadiran check-in)
# - Di Docker / Kubernetes, bisa diarahkan ke service internal (contoh: http://backend:8888)
#
# Production (Server Internal / Localhost Backend): http://localhost:8888
# Local Dev: http://localhost:8888
INTERNAL_API_URL=http://localhost:8888
